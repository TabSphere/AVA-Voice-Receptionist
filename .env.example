# All of these can also be set in the dashboard Settings page
# (saved to data/config.json, which takes precedence over env vars).

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_NUMBER=+44xxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs TTS
ELEVENLABS_API_KEY=xxxxxxxx
ELEVENLABS_VOICE_ID=your_voice_id_here

# Notifications
FREDERICK_WHATSAPP=whatsapp:+447593836195
FREDERICK_NUMBER=+447593836195

# Server
PUBLIC_URL=https://your-ngrok-or-domain.example.com
PORT=3001

# Set to "true" in production to validate Twilio webhook signatures
TWILIO_VALIDATE_SIGNATURE=false

# Optional email notifications (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
